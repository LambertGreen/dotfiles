#!/usr/bin/env bash
# LANDING PAD — sacrificial by design. Keep it THIN.
#
# Tool installers (aisuite, devbar, …) auto-append to ~/.bashrc. This file IS
# that target, so everything below the injection marker is written by tools,
# not by us, and may be rewritten without warning. Do not put real config here.
#
# Your configuration lives in ~/.bashrc.user — that is the big common file, and
# it is safe because no installer knows about it. Add things there.
#
# There is deliberately no ~/.bashrc.local hook. It was a false promise: the
# installers only ever write to ~/.bashrc, so nothing would populate it and it
# only made the split look more capable than it is. See
# docs/SHELL_CONFIG_DESIGN.md.

# Load user configuration FIRST (for proper precedence)
[ -f ~/.bashrc.user ] && source ~/.bashrc.user

# ========================================
# TOOL INJECTION ZONE
# Tools may auto-modify below this line.
#
# This file is tracked ON PURPOSE. The diff is the only window onto what a
# tool did to your login shell, so do NOT gitignore or untrack it -- that
# would trade a visible problem for an invisible one.
#
# When this shows up dirty: look, then choose -- leave it uncommitted, revert
# it (it will come back), or commit it guarded. Anything committed here
# travels to other machines, so every block MUST be $HOME-relative and MUST
# be wrapped in a [[ -d ... ]] guard so it goes inert where the tool is not
# installed. See docs/SHELL_CONFIG_DESIGN.md.
# ========================================

# DevBar: AI agent management tool (Salesforce internal)
# Only enable if DevBar is installed on this system
if [ -d "$HOME/.devbar" ]; then
  export NODE_EXTRA_CA_CERTS="$HOME/.devbar/certs/corporate-ca-bundle.pem"
fi

# >>> aisuite >>>
# Guarded + $HOME-relative by hand; the installer writes absolute work paths.
if [ -d "$HOME/.aisuite" ]; then
  export NODE_EXTRA_CA_CERTS="$HOME/.aisuite/conf/npm-sfdc-certs.pem"
  export PATH="$PATH:$HOME/.aisuite/bin:$HOME/.aisuite/bin/aliases"
fi
# <<< aisuite <<<
# devbar-managed-start
if [ -d "$HOME/.devbar" ]; then
  export NODE_EXTRA_CA_CERTS="$HOME/.devbar/certs/corporate-ca-bundle.pem"
fi
# devbar-managed-end
