#!/usr/bin/env zsh
# LANDING PAD — sacrificial by design. Keep it THIN.
#
# Tool installers (aisuite, devbar, …) auto-append to ~/.zshrc. This file IS
# that target, so everything below the injection marker is written by tools,
# not by us, and may be rewritten without warning. Do not put real config here.
#
# Your configuration lives in ~/.zshrc.user — that is the big common file, and
# it is safe because no installer knows about it. Add things there.
#
# There is deliberately no ~/.zshrc.local hook. It was a false promise: the
# installers only ever write to ~/.zshrc, so nothing would populate it and it
# only made the split look more capable than it is. See
# docs/SHELL_CONFIG_DESIGN.md.

# Load user configuration FIRST (for proper precedence)
[ -f ~/.zshrc.user ] && source ~/.zshrc.user

# ========================================
# TOOL INJECTION ZONE
# Tools may auto-modify below this line.
#
# This file is tracked and stowed, so anything an installer writes here
# travels to every other machine. Until that is fixed, every block below
# MUST be $HOME-relative and MUST be guarded so it goes inert on machines
# where the tool is not installed.
# ========================================

# DevBar: AI agent management tool (Salesforce internal)
# Only enable if DevBar is installed on this system
if [[ -d "$HOME/.devbar" ]]; then
  export NODE_EXTRA_CA_CERTS="$HOME/.devbar/certs/corporate-ca-bundle.pem"
fi

# >>> aisuite >>>
# Guarded + $HOME-relative by hand; the installer writes absolute work paths.
if [[ -d "$HOME/.aisuite" ]]; then
  export NODE_EXTRA_CA_CERTS="$HOME/.aisuite/conf/npm-sfdc-certs.pem"
  export PATH="$PATH:$HOME/.aisuite/bin:$HOME/.aisuite/bin/aliases"
fi
# <<< aisuite <<<
# devbar-managed-start
if [[ -d "$HOME/.devbar" ]]; then
  export NODE_EXTRA_CA_CERTS="$HOME/.devbar/certs/corporate-ca-bundle.pem"
fi
# devbar-managed-end
